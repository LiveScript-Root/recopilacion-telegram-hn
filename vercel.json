{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/nexo-production/index.html"
    },
    {
      "source": "/anunciar/",
      "destination": "/nexo-production/anunciar/index.html"
    },
    {
      "source": "/pago/",
      "destination": "/nexo-production/pago/index.html"
    },
    {
      "source": "/solicitud-recibida/",
      "destination": "/nexo-production/solicitud-recibida/index.html"
    },
    {
      "source": "/contacto/",
      "destination": "/nexo-production/contacto/index.html"
    },
    {
      "source": "/eliminacion/",
      "destination": "/nexo-production/eliminacion/index.html"
    },
    {
      "source": "/terminos/",
      "destination": "/nexo-production/terminos/index.html"
    },
    {
      "source": "/privacidad/",
      "destination": "/nexo-production/privacidad/index.html"
    },
    {
      "source": "/robots.txt",
      "destination": "/nexo-production/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/nexo-production/sitemap.xml"
    },
    {
      "source": "/nexo-control-9x4/",
      "destination": "/nexo-production/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.paypal.com https://www.paypalobjects.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co https://www.paypal.com https://www.paypalobjects.com; connect-src 'self' https://*.supabase.co https://www.paypal.com https://*.paypal.com; frame-src https://www.paypal.com https://*.paypal.com; form-action 'self' https://www.paypal.com; font-src 'self' data:; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/pago/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/solicitud-recibida/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/images/perfiles/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noimageindex, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    },
    {
      "source": "/nexo-control-9x4/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
